#!/bin/sh
# .githooks/pre-commit -- author guard
#
# History lesson (5ce84eb): merge commit landed with user.name=MXM
# (the Windows OS username) instead of the role identity 'computer_analyst'.
# That commit lives forever in public history. This hook prevents recurrence.
#
# Reject the commit if user.name is one of the well-known default / unset
# values. To bypass once (rare cases), run with GIT_BYPASS_AUTHOR=1.

NAME=$(git config user.name)
EMAIL=$(git config user.email)

case "$NAME" in
  ""|"MXM"|"Your Name"|"root"|"Administrator"|"User"|"git")
    if [ "$GIT_BYPASS_AUTHOR" = "1" ]; then
      echo "[pre-commit] bypassed via GIT_BYPASS_AUTHOR=1 (user.name='$NAME')"
      exit 0
    fi
    echo "[pre-commit] BLOCKED: user.name='$NAME' is a default / unset value."
    echo ""
    echo "  This repo (HJSSSRX/xiaokon-all) requires a role-scoped identity."
    echo "  For the computer_analyst role:"
    echo ""
    echo "    git config user.name  'computer_analyst'"
    echo "    git config user.email 'computer-analyst@xiaokong.local'"
    echo ""
    echo "  To bypass once (NOT recommended):"
    echo "    GIT_BYPASS_AUTHOR=1 git commit ..."
    exit 1
    ;;
esac

# user.email sanity (warn only, don't block)
case "$EMAIL" in
  ""|"you@example.com"|"mxm@example.com")
    echo "[pre-commit] warn: user.email='$EMAIL' looks like a default; consider fixing."
    ;;
esac

# ─── Python import sanity gate ──────────────────────────────────────
# Runs only when .py files are staged. Blocks the commit if any
# infrastructure module fails to import, preventing regressions in
# core / collab / cli / shim layers.
#
# Check       : pre-commit
# Scope       : staged .py files only
# Falls back  : skip if Python not found
# Bypass once : GIT_BYPASS_IMPORT=1 git commit ...

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.py$' || true)

if [ -n "$STAGED_PY" ]; then
  PY=""
  for cand in python3 python; do
    path=$(command -v "$cand" 2>/dev/null) || continue
    # test that Python actually runs (some Store stubs exit silently)
    if "$path" -c "print(1)" >/dev/null 2>&1; then
      PY="$path"
      break
    fi
  done

  if [ -z "$PY" ]; then
    echo "[pre-commit] warn: no working Python found; skipping import check"
  else
    "$PY" -c "
import importlib, sys
modules = [
    'tools.core',
    'tools.collab',
    'tools.collab_hub',
    'tools.collab_sync',
    'tools.cli',
    'tools.smart_scheduler',
    'tools.kb_search',
    'tools.captain',
    'tools.answer_format_lint',
    'tools.generate_role_prompts_v5',
]
failed = []
for m in modules:
    try:
        importlib.import_module(m)
    except Exception as e:
        failed.append(f'  {m}  ->  {e}')
if failed:
    print('[pre-commit] IMPORT CHECK FAILED — these modules are broken:')
    for line in failed:
        print(line)
    print()
    print('  Fix the imports before committing, or bypass once:')
    print('    GIT_BYPASS_IMPORT=1 git commit ...')
    sys.exit(1)
print('[pre-commit] import check passed (' + str(len(modules)) + ' modules)')
"
    rc=$?
    if [ "$rc" != 0 ] && [ "$GIT_BYPASS_IMPORT" != "1" ]; then
      exit 1
    fi
  fi
fi

exit 0
